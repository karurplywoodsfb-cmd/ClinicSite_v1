# ═══════════════════════════════════════════════════════════════════
# ClinicSite.in — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Razorpay (Payment Gateway) ────────────────────────────────────
# From: Razorpay Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Razorpay Plan IDs (create in Razorpay Dashboard → Subscriptions → Plans)
VITE_RAZORPAY_PLAN_PREMIUM=plan_xxxxxxxxxxxx
VITE_RAZORPAY_PLAN_ENTERPRISE=plan_xxxxxxxxxxxx

# ── Push Notifications (Web Push / VAPID) ─────────────────────────
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── MSG91 (SMS + WhatsApp Notifications) ─────────────────────────
# From: MSG91 Dashboard → API → Authkey
# NOTE: Do NOT expose these client-side in production.
# They are used only via Supabase Edge Functions (server-side).
# If you must call MSG91 from the browser (not recommended), add them here.
VITE_MSG91_API_KEY=your-msg91-api-key
VITE_MSG91_WA_SENDER=your-whatsapp-sender-number

# ── App Config ────────────────────────────────────────────────────
# Base URL of your deployed app (no trailing slash)
VITE_APP_URL=https://clinicsite.in
VITE_SUPPORT_EMAIL=support@clinicsite.in
