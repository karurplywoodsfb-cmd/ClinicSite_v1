# ═══════════════════════════════════════════════════════════════════
# Supabase Edge Functions — Secrets
# Set via: supabase secrets set KEY=value
# List current: supabase secrets list
# ═══════════════════════════════════════════════════════════════════

# ── Supabase (auto-injected in deployed functions, needed for local dev) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── MSG91 Notifications ───────────────────────────────────────────
MSG91_API_KEY=your-msg91-api-key
MSG91_WA_SENDER=your-whatsapp-sender-number

# ── Web Push (VAPID) ──────────────────────────────────────────────
# Must match VITE_VAPID_PUBLIC_KEY in the frontend .env
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:support@clinicsite.in

# ── Vercel API (for custom domain management) ─────────────────────
# From: Vercel Dashboard → Settings → Tokens
VERCEL_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id   # leave blank for personal accounts
